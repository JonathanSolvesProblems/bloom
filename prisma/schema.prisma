generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  name                 String
  type                 String
  city                 String
  province             String          @default("")
  country              String          @default("CA")
  description          String
  brandVoice           String          @default("friendly")
  promotions           String?
  ownerEmail           String          @unique
  ownerName            String
  // Owner-only bearer token for the dashboard. Never exposed on public pages.
  dashboardToken       String          @unique @default(cuid())
  tier                 String          @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String          @default("inactive")
  subscribers          Subscriber[]
  weeklyContent        WeeklyContent[]
  agentLogs            AgentLog[]
}

model Subscriber {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  email      String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, email])
}

model WeeklyContent {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  weekOf            String
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  post1             String
  post2             String
  post3             String
  newsletterSubject String
  newsletterHtml    String
  newsletterSent    Boolean   @default(false)
  newsletterSentAt  DateTime?
  subscriberCount   Int       @default(0)
  // Agent decision record + run evidence
  weeklyTheme       String?
  featuredPromotion String?
  subjectVariants   String?
  reasoning         String?
  qaScore           Int?
  // The self-critique is a gate: when it rejects a draft the agent rewrites it once.
  regenerated       Boolean   @default(false)
  rejectedQaScore   Int?
  model             String?
  tokensUsed        Int?
  latencyMs         Int?

  @@unique([businessId, weekOf])
}

model AgentLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  action     String
  summary    String
  details    String?
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
}
