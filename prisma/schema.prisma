generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  name                 String
  type                 String
  city                 String
  province             String          @default("")
  country              String          @default("CA")
  // Physical mailing address shown in every newsletter footer. Anti-spam law
  // (CAN-SPAM, CASL) requires a real postal address on commercial email, so the
  // Pro send path refuses to deliver until this is set.
  mailingAddress       String          @default("")
  description          String
  brandVoice           String          @default("friendly")
  // Language the agent writes the customer-facing content in (ISO 639-1).
  contentLanguage      String          @default("en")
  // Paid branding: a hex color and a hosted logo URL rendered into the
  // newsletter header. Empty means Bloom's default green with no logo.
  brandColor           String          @default("")
  logoUrl              String          @default("")
  promotions           String?
  ownerEmail           String          @unique
  ownerName            String
  // Owner-only bearer token for the dashboard. Never exposed on public pages.
  dashboardToken       String          @unique @default(cuid())
  tier                 String          @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String          @default("inactive")
  // True once the owner has cancelled but the paid period has not ended yet, so
  // the dashboard can show "cancelling" instead of a bare "active".
  cancelAtPeriodEnd    Boolean         @default(false)
  subscribers          Subscriber[]
  weeklyContent        WeeklyContent[]
  agentLogs            AgentLog[]
  clients              Client[]

  // The weekly dispatcher filters on subscriptionStatus; the Stripe webhook
  // looks a business up by stripeCustomerId. Both run on every event.
  @@index([subscriptionStatus])
  @@index([stripeCustomerId])
}

/// A real client of the business, imported from their booking history.
///
/// This is what makes the retention agent possible and hard to copy: it knows
/// each person's own rhythm, not a generic rule. A 4-week regular who is 6 weeks
/// out is in trouble; an 8-week regular at 6 weeks is fine. You cannot get that
/// from a prompt, only from their actual booking history.
model Client {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  name         String
  email        String
  // Derived from the imported visit history at import time.
  firstVisitAt DateTime
  lastVisitAt  DateTime
  visitCount   Int       @default(1)
  lastService  String    @default("")
  avgSpend     Float     @default(0)
  /// Median days between this client's visits. Null when they have only ever
  /// visited once, which is exactly the highest-risk case.
  cadenceDays  Int?
  /// A drafted win-back the owner has not yet approved. Held here so the owner can
  /// read exactly what will be sent before it goes, which is the whole trust story
  /// of a product that emails your clients. Cleared on send or discard.
  winBackDraft   String?
  winBackDraftedAt DateTime?
  /// Set when the agent has already reached out, so it never nags twice.
  winBackSentAt DateTime?
  /// Anti-spam law applies to win-back email too. Once set, the agent will never
  /// contact this person again.
  unsubscribedAt DateTime?
  /// Set when they booked again after a win-back, which is how revenue recovered
  /// is measured rather than claimed.
  recoveredAt  DateTime?

  @@unique([businessId, email])
  @@index([businessId, lastVisitAt])
}

model Subscriber {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  email      String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, email])
}

model WeeklyContent {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  weekOf            String
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  post1             String
  post2             String
  post3             String
  newsletterSubject String
  newsletterHtml    String
  newsletterSent    Boolean   @default(false)
  newsletterSentAt  DateTime?
  subscriberCount   Int       @default(0)
  // Agent decision record + run evidence
  weeklyTheme       String?
  featuredPromotion String?
  subjectVariants   String?
  reasoning         String?
  qaScore           Int?
  // The self-critique is a gate: when it rejects a draft the agent rewrites it once.
  regenerated       Boolean   @default(false)
  rejectedQaScore   Int?
  model             String?
  tokensUsed        Int?
  latencyMs         Int?

  @@unique([businessId, weekOf])
  // The dispatcher scans every row for the current weekOf on each run.
  @@index([weekOf])
}

model AgentLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  action     String
  summary    String
  details    String?

  // The public /agent feed and the dashboard both read newest-first, per business.
  @@index([businessId, createdAt])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())

  // pruneRateLimits deletes by age on every cron run.
  @@index([createdAt])
}
