# Copy this file to .env and fill in real values. Never commit your real .env.
# =============================================================================

# Neon Postgres connection string (https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Gemini through Vertex AI. Set VERTEX_API_KEY to run on Google Cloud, which is
# what production uses. GEMINI_API_KEY is the AI Studio fallback for local work.
VERTEX_API_KEY=""
GEMINI_API_KEY=""

# Stripe secret key (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""

# Signing secret for the Stripe webhook that hits /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Resend API key for sending newsletters (https://resend.com)
RESEND_API_KEY=""

# Verified sending domain. Without it the agent refuses to send rather than
# reporting a delivery that never happened.
RESEND_FROM_DOMAIN=""

# Shared secret the weekly cron sends as a Bearer token to /api/cron/weekly
CRON_SECRET=""

# Public origin. Baked into the client bundle and used for unsubscribe links.
NEXT_PUBLIC_APP_URL="https://bloom.jonathanandrei.com"

# Support/contact address shown in the footer and on the legal pages. Must be a
# monitored inbox and should match the support email on the Stripe account.
# Baked into the client bundle, so a change needs a rebuild.
NEXT_PUBLIC_SUPPORT_EMAIL="jonathan@jonathanandrei.com"

# Self-hosted only: where the weekly dispatcher reaches its own workers. Use the
# container name, not the compose service name: the docker network is shared and
# a generic alias like `app` resolves to another stack. Leave unset on Vercel.
INTERNAL_APP_URL="http://bloom:3000"
